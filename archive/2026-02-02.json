date":"2026-02-02","observer":"Adam Flores","type":"At-Risk Condition","description":"Had a lot of drill pipe racked back & the floor was small. Got sent 9 7/8 clincher tongs so when we came of the pipe had to watch pinch points because it was a tight spot. ","location":"ICD 332","service_line":"Casing","report_number":"74298550","yard":""}]},"near_misses":[{"date":"2026-02-02","observer":"Daniel Carlos","type":"Near Miss","description":"Coming down to latch joint when back end cam up and almost off the skate","location":"Pulling unit","service_line":"Casing","report_number":"74336704","yard":"Midland"}],"incidents":[{"date":"2026-02-02","employee":"","type":"Equipment Damage/Property Damage","description":"Incident Description\nAn employee was in the process of setting anchors on a multi-well pad. A valid One Call ticket was in hand, and the location had been properly flagged. Two anchors were installed without incident. While setting the third anchor, the employee struck a steel line approximately six inches below ground surface.\n\nUpon contact, the line ruptured and released a large volume of air. No water or oil was observed. The employee immediately shut down operations and vacated the area. The incident was promptly reported to management and Permian personnel.\n\nThe employee was instructed to move his truck out of the area if it could be done safely. He was able to relocate the vehicle without issue. Permian personnel arrived on location and identified the damaged line as a compressed air line. They isolated and closed the line, eliminating the release.\n\nPermian then contacted their line locate group to fully locate the line. Our truck will remain released from the area until the line has been completely located and the job is cleared to resume","location":"HAMMAN 45A TIG 11A ","service_line":"Anchor","company":"Butch's Rat Hole & Anchor Service Inc","report_number":"74362003"}],"assessments":{"total":11,"details":[{"date":"2026-02-02","assessor":"Michael Salazar","form_id":381707,"division":"Casing","location":"","report_number":"74361444"},{"date":"2026-02-02","assessor":"Roger Gray","form_id":229645,"division":"Casing","location":"","report_number":"74376922"},{"date":"2026-02-02","assessor":"James Sellers","form_id":229645,"division":"Casing","location":"","report_number":"74375991"},{"date":"2026-02-02","assessor":"James Sellers","form_id":229645,"division":"Casing","location":"","report_number":"74375959"},{"date":"2026-02-02","assessor":"Rafael Munoz","form_id":229645,"division":"Casing","location":"","report_number":"74345731"},{"date":"2026-02-02","assessor":"Rafael Munoz","form_id":229645,"division":"Casing","location":"","report_number":"74345654"},{"date":"2026-02-02","assessor":"Anthony Ellis","form_id":229645,"division":"Casing","location":"","report_number":"74326235"},{"date":"2026-02-02","assessor":"Cesar Herrera Garcia","form_id":229645,"division":"Casing","location":"","report_number":"74297155"},{"date":"2026-02-02","assessor":"James Sellers","form_id":229645,"division":"Casing","location":"","report_number":"74287810"},{"date":"2026-02-02","assessor":"James Sellers","form_id":229645,"division":"Casing","location":"","report_number":"74287785"},{"date":"2026-02-02","assessor":"Laredo Dispatch","form_id":229645,"division":"Casing","location":"","report_number":"74285872"}]}},"ytd":{"report_date":"2026-02-02","ytd_trir":0.0,"ytd_dart":0.0,"ytd_recordables":0,"ytd_man_hours":278559,"days_since_lti":null,"days_since_recordable":null,"last_recordable_date":null},"cas":null,"training":null,"devices":null}