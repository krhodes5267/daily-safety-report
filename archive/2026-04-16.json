rtin Lopez was working the vdoor and driller was coming in with pipe to fast he couldn't get the rope in time he's hollered out in time and everyone was able to get out of the way in time and no one got hurt ","location":"502 hp","service_line":"Casing","report_number":"79388188"},{"date":"2026-04-16","observer":"Anthony Trevino","type":"Recognition","description":"Side loaded shackle ","location":"PU","service_line":"Casing","report_number":"79387305"},{"date":"2026-04-16","observer":"Joel Villanueva","type":"Recognition","description":"Employe seen missing keeper on slips for 6\nStoped and fixed ","location":"Valik 6 federa ","service_line":"Drilling","report_number":"79367822"},{"date":"2026-04-16","observer":"Michael Vinson","type":"Good Catch","description":"While walking around the rig I noticed some bolts had backed out on One of the hydraulic pumps on rig ","location":"Pelee 621H/ rig move/ rig up ","service_line":"","report_number":"79439708"}]},"near_misses":[{"date":"2026-04-16","observer":"Giovanni Jimenez","type":"Near Miss","description":"Shackle missing keeper ","location":"Hp 244","service_line":"Casing","report_number":"79441357"}],"incidents":[],"assessments":{"total":17,"details":[{"date":"2026-04-16","assessor":"Anthony Ellis","form_id":229645,"division":"Casing","location":"","report_number":"79456665"},{"date":"2026-04-16","assessor":"James Sellers","form_id":229645,"division":"Casing","location":"","report_number":"79445016"},{"date":"2026-04-16","assessor":"James Sellers","form_id":229645,"division":"Casing","location":"","report_number":"79444982"},{"date":"2026-04-16","assessor":"Laredo Dispatch","form_id":229645,"division":"Casing","location":"","report_number":"79443038"},{"date":"2026-04-16","assessor":"Mitchell Gentry Jr","form_id":229645,"division":"Casing","location":"","report_number":"79440189"},{"date":"2026-04-16","assessor":"Cesar Herrera Garcia","form_id":229645,"division":"Casing","location":"","report_number":"79437034"},{"dat